<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="GemEquipment" nillable="true" type="GemEquipmentConfig" />
  <xs:complexType name="GemEquipmentConfig">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="SecsHsms" type="SecsHsmsConfig" />
      <xs:element minOccurs="0" maxOccurs="1" name="SecsSerial" type="SecsSerialConfig" />
      <xs:element minOccurs="0" maxOccurs="1" name="Standard" type="GemStandardIdsConfig" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="SV" type="GemStatusVariableConfig" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="DV" type="GemDataVariableConfig" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="EC" type="GemEquipmentConstantConfig" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="CE" type="GemCollectionEventConfig" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Alarm" type="GemAlarmConfig" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Command" type="GemRemoteCommandConfig" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Message" type="GemMessageConfig" />
    </xs:sequence>
    <xs:attribute default="" name="ModelName" type="xs:string" use="optional" />
    <xs:attribute default="" name="SoftwareRevision" type="xs:string" use="optional" />
    <xs:attribute default="U4" name="VidFormat" type="xs:string" use="optional" />
    <xs:attribute default="U4" name="CeidFormat" type="xs:string" use="optional" />
    <xs:attribute default="U4" name="RptidFormat" type="xs:string" use="optional" />
    <xs:attribute default="U4" name="AlidFormat" type="xs:string" use="optional" />
    <xs:attribute default="U4" name="DataidFormat" type="xs:string" use="optional" />
    <xs:attribute default="Enabled" name="InitialCommunicationState" type="GemEnableState" use="optional" />
    <xs:attribute default="true" name="InitiateCommunication" type="xs:boolean" use="optional" />
    <xs:attribute default="HostOffline" name="InitialControlState" type="GemControlState" use="optional" />
    <xs:attribute default="EquipmentOffline" name="OnlineFailedState" type="GemControlState" use="optional" />
    <xs:attribute default="false" name="EventsEnabledByDefault" type="xs:boolean" use="optional" />
    <xs:attribute default="false" name="AlarmsEnabledByDefault" type="xs:boolean" use="optional" />
    <xs:attribute default="true" name="EventReplyExpected" type="xs:boolean" use="optional" />
    <xs:attribute default="true" name="AlarmReplyExpected" type="xs:boolean" use="optional" />
    <xs:attribute default="true" name="TerminalReplyExpected" type="xs:boolean" use="optional" />
    <xs:attribute default="10000" name="CommandReplyTimeout" type="xs:int" use="optional" />
    <xs:attribute default="1000" name="MaxPendingSends" type="xs:int" use="optional" />
    <xs:attribute default="10000" name="MaxPendingEvents" type="xs:int" use="optional" />
  </xs:complexType>
  <xs:complexType name="SecsHsmsConfig">
    <xs:attribute default="Host" name="Role" type="SecsRole" use="optional" />
    <xs:attribute default="0" name="DeviceID" type="xs:int" use="optional" />
    <xs:attribute default="45000" name="T3" type="xs:int" use="optional" />
    <xs:attribute default="Active" name="Mode" type="HsmsMode" use="optional" />
    <xs:attribute default="127.0.0.1" name="RemoteIP" type="xs:string" use="optional" />
    <xs:attribute default="5000" name="RemotePort" type="xs:int" use="optional" />
    <xs:attribute default="0.0.0.0" name="LocalIP" type="xs:string" use="optional" />
    <xs:attribute default="5000" name="LocalPort" type="xs:int" use="optional" />
    <xs:attribute default="10000" name="T5" type="xs:int" use="optional" />
    <xs:attribute default="5000" name="T6" type="xs:int" use="optional" />
    <xs:attribute default="10000" name="T7" type="xs:int" use="optional" />
    <xs:attribute default="5000" name="T8" type="xs:int" use="optional" />
    <xs:attribute default="60000" name="LinktestInterval" type="xs:int" use="optional" />
    <xs:attribute default="16777216" name="MaxMessageSize" type="xs:int" use="optional" />
    <xs:attribute default="true" name="AutoReconnect" type="xs:boolean" use="optional" />
  </xs:complexType>
  <xs:simpleType name="SecsRole">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Host" />
      <xs:enumeration value="Equipment" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="HsmsMode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Active" />
      <xs:enumeration value="Passive" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="SecsSerialConfig">
    <xs:attribute default="Host" name="Role" type="SecsRole" use="optional" />
    <xs:attribute default="0" name="DeviceID" type="xs:int" use="optional" />
    <xs:attribute default="45000" name="T3" type="xs:int" use="optional" />
    <xs:attribute default="COM1" name="Port" type="xs:string" use="optional" />
    <xs:attribute default="9600" name="Baudrate" type="xs:int" use="optional" />
    <xs:attribute default="None" name="Parity" type="Parity" use="optional" />
    <xs:attribute default="8" name="DataBits" type="xs:int" use="optional" />
    <xs:attribute default="One" name="StopBits" type="StopBits" use="optional" />
    <xs:attribute default="500" name="T1" type="xs:int" use="optional" />
    <xs:attribute default="10000" name="T2" type="xs:int" use="optional" />
    <xs:attribute default="45000" name="T4" type="xs:int" use="optional" />
    <xs:attribute default="3" name="RetryLimit" type="xs:int" use="optional" />
    <xs:attribute name="IsMaster" type="xs:boolean" use="optional" />
    <xs:attribute default="true" name="DuplicateDetection" type="xs:boolean" use="optional" />
    <xs:attribute default="false" name="AutoReconnect" type="xs:boolean" use="optional" />
  </xs:complexType>
  <xs:simpleType name="Parity">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="Odd" />
      <xs:enumeration value="Even" />
      <xs:enumeration value="Mark" />
      <xs:enumeration value="Space" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="StopBits">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="One" />
      <xs:enumeration value="Two" />
      <xs:enumeration value="OnePointFive" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="GemStandardIdsConfig">
    <xs:attribute name="Clock" type="xs:string" use="optional" />
    <xs:attribute name="ControlState" type="xs:string" use="optional" />
    <xs:attribute name="PreviousControlState" type="xs:string" use="optional" />
    <xs:attribute name="EventsEnabled" type="xs:string" use="optional" />
    <xs:attribute name="AlarmsEnabled" type="xs:string" use="optional" />
    <xs:attribute name="AlarmsSet" type="xs:string" use="optional" />
    <xs:attribute name="ProcessState" type="xs:string" use="optional" />
    <xs:attribute name="PreviousProcessState" type="xs:string" use="optional" />
    <xs:attribute name="EstablishCommunicationsTimeout" type="xs:string" use="optional" />
    <xs:attribute name="TimeFormat" type="xs:string" use="optional" />
    <xs:attribute name="AlarmID" type="xs:string" use="optional" />
    <xs:attribute name="EquipmentOffline" type="xs:string" use="optional" />
    <xs:attribute name="ControlStateLocal" type="xs:string" use="optional" />
    <xs:attribute name="ControlStateRemote" type="xs:string" use="optional" />
    <xs:attribute name="ProcessStateChange" type="xs:string" use="optional" />
    <xs:attribute name="OperatorEquipmentConstantChange" type="xs:string" use="optional" />
    <xs:attribute name="MessageRecognition" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="GemStatusVariableConfig">
    <xs:attribute name="Id" type="xs:string" use="required" />
    <xs:attribute name="Name" type="xs:string" use="required" />
    <xs:attribute name="Format" type="xs:string" use="required" />
    <xs:attribute default="" name="Units" type="xs:string" use="optional" />
    <xs:attribute name="InitialValue" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="GemDataVariableConfig">
    <xs:attribute name="Id" type="xs:string" use="required" />
    <xs:attribute name="Name" type="xs:string" use="required" />
    <xs:attribute name="Format" type="xs:string" use="required" />
    <xs:attribute default="" name="Units" type="xs:string" use="optional" />
    <xs:attribute name="InitialValue" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="GemEquipmentConstantConfig">
    <xs:attribute name="Id" type="xs:string" use="required" />
    <xs:attribute name="Name" type="xs:string" use="required" />
    <xs:attribute name="Format" type="xs:string" use="required" />
    <xs:attribute name="Default" type="xs:string" use="required" />
    <xs:attribute name="Min" type="xs:string" use="optional" />
    <xs:attribute name="Max" type="xs:string" use="optional" />
    <xs:attribute default="" name="Units" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="GemCollectionEventConfig">
    <xs:attribute name="Id" type="xs:string" use="required" />
    <xs:attribute name="Name" type="xs:string" use="required" />
    <xs:attribute default="" name="Vids" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="GemAlarmConfig">
    <xs:attribute name="Id" type="xs:string" use="required" />
    <xs:attribute name="Text" type="xs:string" use="required" />
    <xs:attribute name="Category" type="xs:int" use="required" />
    <xs:attribute name="SetCeid" type="xs:string" use="required" />
    <xs:attribute name="ClearCeid" type="xs:string" use="required" />
  </xs:complexType>
  <xs:complexType name="GemRemoteCommandConfig">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Param" type="GemCommandParameterConfig" />
    </xs:sequence>
    <xs:attribute name="Name" type="xs:string" use="required" />
  </xs:complexType>
  <xs:complexType name="GemCommandParameterConfig">
    <xs:attribute name="Name" type="xs:string" use="required" />
    <xs:attribute name="Format" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="GemMessageConfig">
    <xs:attribute name="Stream" type="xs:int" use="required" />
    <xs:attribute name="Function" type="xs:int" use="required" />
  </xs:complexType>
  <xs:simpleType name="GemEnableState">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Disabled" />
      <xs:enumeration value="Enabled" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="GemControlState">
    <xs:restriction base="xs:string">
      <xs:enumeration value="EquipmentOffline" />
      <xs:enumeration value="AttemptOnline" />
      <xs:enumeration value="HostOffline" />
      <xs:enumeration value="OnlineLocal" />
      <xs:enumeration value="OnlineRemote" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>