<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="SecsSerial" nillable="true" type="SecsSerialConfig" />
  <xs:complexType name="SecsSerialConfig">
    <xs:attribute default="Host" name="Role" type="SecsRole" use="optional" />
    <xs:attribute default="0" name="DeviceID" type="xs:int" use="optional" />
    <xs:attribute default="45000" name="T3" type="xs:int" use="optional" />
    <xs:attribute default="COM1" name="Port" type="xs:string" use="optional" />
    <xs:attribute default="9600" name="Baudrate" type="xs:int" use="optional" />
    <xs:attribute default="None" name="Parity" type="Parity" use="optional" />
    <xs:attribute default="8" name="DataBits" type="xs:int" use="optional" />
    <xs:attribute default="One" name="StopBits" type="StopBits" use="optional" />
    <xs:attribute default="500" name="T1" type="xs:int" use="optional" />
    <xs:attribute default="10000" name="T2" type="xs:int" use="optional" />
    <xs:attribute default="45000" name="T4" type="xs:int" use="optional" />
    <xs:attribute default="3" name="RetryLimit" type="xs:int" use="optional" />
    <xs:attribute name="IsMaster" type="xs:boolean" use="optional" />
    <xs:attribute default="true" name="DuplicateDetection" type="xs:boolean" use="optional" />
    <xs:attribute default="false" name="AutoReconnect" type="xs:boolean" use="optional" />
  </xs:complexType>
  <xs:simpleType name="SecsRole">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Host" />
      <xs:enumeration value="Equipment" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Parity">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="Odd" />
      <xs:enumeration value="Even" />
      <xs:enumeration value="Mark" />
      <xs:enumeration value="Space" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="StopBits">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="One" />
      <xs:enumeration value="Two" />
      <xs:enumeration value="OnePointFive" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>